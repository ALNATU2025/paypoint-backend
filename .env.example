# ---- Required ----
# MongoDB connection string (MongoDB Atlas free tier works well).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/paypoint?retryWrites=true&w=majority
# Long random string used to sign login tokens (at least 32 characters).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ---- VTPass (cable TV) ----
# Find these in your VTPass dashboard: Settings > API Keys.
VTPASS_MODE=live            # live | sandbox
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# ---- Paystack (wallet funding by card / bank transfer) ----
PAYSTACK_SECRET_KEY=        # sk_live_...
# Public URL of this API, used for Paystack's redirect after payment.
PUBLIC_URL=https://paypoint-backend-aj52.onrender.com

# ---- Optional ----
ADMIN_API_KEY=              # enables POST /api/admin/wallet/credit (header x-admin-key)
SERVICE_FEE_NAIRA=0         # flat fee added to each cable payment
MIN_FUND_NAIRA=100
MAX_FUND_NAIRA=500000
