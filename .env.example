# ---- Required ----
# MongoDB connection string (MongoDB Atlas free tier works well).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/paypoint?retryWrites=true&w=majority
# Long random string used to sign login tokens (at least 32 characters).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ---- VTPass (cable TV) ----
# VTPass dashboard > Settings > API Keys. Paste the values only, no quotes.
VTPASS_MODE=live            # live | sandbox
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
# VTPASS_PUBLIC_KEY=        # optional

# ---- Optional ----
ADMIN_EMAILS=payonpointng@gmail.com   # admin dashboard access (comma-separated)
SUPER_ADMIN_EMAILS=alusinebarrie578@gmail.com  # funds the Paypoint wallet; hidden from admins
ADMIN_REVENUE_PERCENT=1.3        # admin's revenue share of each successful payment
SUPER_ADMIN_REVENUE_PERCENT=0.5  # super admin's share (kept as a record)
ADMIN_API_KEY=              # lets scripts call /api/admin/* with header x-admin-key
SERVICE_FEE_NAIRA=0         # flat fee added to each cable payment
